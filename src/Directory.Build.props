<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <Authors>Dilcore</Authors>
    <Company>Dilcore</Company>
    <RepositoryUrl>https://github.com/Dilcore-Official/Dilcore-MongoDb</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Dilcore-Official/Dilcore-MongoDb</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
